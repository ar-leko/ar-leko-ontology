# ---- 5.10 Ámbitos marítimos (LISTA TAXATIVA) -----------------------

arlekov:EsquemaAmbitoMaritimo a skos:ConceptScheme ;
    skos:prefLabel "Ámbitos marítimos"@es ;
    skos:prefLabel "Maritime scopes"@en ;
    skos:prefLabel "Âmbitos marítimos"@pt ;
    skos:definition "Categorías de espacios marítimos relevantes para describir el ámbito espacial de normas. Su inclusión no implica que Argentina ejerza soberanía o derechos soberanos sobre todos ellos."@es .

arlekov:AmbitoMaritimo-MarTerritorial a skos:Concept ; skos:inScheme arlekov:EsquemaAmbitoMaritimo ;
    skos:prefLabel "Mar territorial"@es ; skos:prefLabel "Territorial sea"@en ; skos:prefLabel "Mar territorial"@pt ;
    skos:scopeNote "Hasta 12 millas marinas desde las líneas de base. Soberanía del Estado ribereño."@es .
arlekov:AmbitoMaritimo-ZonaContigua a skos:Concept ; skos:inScheme arlekov:EsquemaAmbitoMaritimo ;
    skos:prefLabel "Zona contigua"@es ; skos:prefLabel "Contiguous zone"@en ; skos:prefLabel "Zona contígua"@pt ;
    skos:scopeNote "Hasta 24 millas marinas desde las líneas de base."@es .
arlekov:AmbitoMaritimo-ZonaEconomicaExclusiva a skos:Concept ; skos:inScheme arlekov:EsquemaAmbitoMaritimo ;
    skos:prefLabel "Zona Económica Exclusiva (ZEE)"@es ; skos:prefLabel "Exclusive Economic Zone (EEZ)"@en ; skos:prefLabel "Zona Econômica Exclusiva (ZEE)"@pt ;
    skos:scopeNote "Hasta 200 millas marinas. Derechos de soberanía para exploración y explotación de recursos."@es .
arlekov:AmbitoMaritimo-PlataformaContinental a skos:Concept ; skos:inScheme arlekov:EsquemaAmbitoMaritimo ;
    skos:prefLabel "Plataforma continental"@es ; skos:prefLabel "Continental shelf"@en ; skos:prefLabel "Plataforma continental"@pt ;
    skos:scopeNote "Lecho y subsuelo marino más allá del mar territorial, hasta el borde exterior del margen continental o 200 millas."@es .
arlekov:AmbitoMaritimo-AltaMar a skos:Concept ; skos:inScheme arlekov:EsquemaAmbitoMaritimo ;
    skos:prefLabel "Alta mar"@es ; skos:prefLabel "High seas"@en ; skos:prefLabel "Alto-mar"@pt ;
    skos:scopeNote "Partes del mar no incluidas en ZEE, mar territorial, aguas interiores o aguas archipelágicas. Abierta a todos los Estados; no constituye un espacio bajo soberanía argentina."@es .

