@prefix arleko:  <https://w3id.org/arleko#> .
@prefix arlekov: <https://w3id.org/arleko/vocab#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eli:     <http://data.europa.eu/eli/ontology#> .
@prefix vann:    <http://purl.org/vocab/vann/> .

# =====================================================================
# 0. ENCABEZADO DE LA ONTOLOGÍA
# IRI de la ontología:  https://w3id.org/arleko
# IRI de esta versión:  https://w3id.org/arleko/1.3.0
# Namespace de términos: https://w3id.org/arleko#
# Namespace de vocabularios: https://w3id.org/arleko/vocab#
#
# w3id.org no aloja este archivo: redirige esos IRI a las representaciones
# publicadas con este repositorio. La redirección queda definida en
# publication/w3id/ids/arleko/.htaccess y solo resuelve después de que
# el pull request a perma-id/w3id.org esté fusionado.
# =====================================================================

<https://w3id.org/arleko> a owl:Ontology ;
    owl:versionIRI <https://w3id.org/arleko/1.3.0> ;
    owl:versionInfo "1.3.0" ;
    dcterms:title "AR-LEKO - Ontología del Conocimiento Jurídico Argentino"@es ;
    dcterms:title "AR-LEKO - Argentine Legal Knowledge Ontology"@en ;
    dcterms:title "AR-LEKO - Ontologia do Conhecimento Jurídico Argentino"@pt ;
    dcterms:description "Ontología OWL 2 para representar normas jurídicas argentinas, su estructura, sus versiones temporales, sus modificaciones y su contexto institucional y territorial."@es ;
    dcterms:description "OWL 2 ontology for Argentine legal norms, their structure, temporal versions, amendments, and institutional and territorial context."@en ;
    dcterms:created "2026-11-20"^^xsd:date ;
    dcterms:modified "2026-11-20"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:creator <https://github.com/ar-leko> ;
    vann:preferredNamespacePrefix "arleko" ;
    vann:preferredNamespaceUri "https://w3id.org/arleko#" ;
    rdfs:comment """AR-LEKO (Argentine Legal Knowledge Ontology) es una ontología OWL 2 para representar
normas jurídicas argentinas de cualquier nivel y de cualquier organismo emisor.

CAMBIOS v1.3.0:
- Etiquetas en portugués (@pt) para todas las clases, propiedades y conceptos.
- Esquema restrictivo de unidades territoriales (arlekov:EsquemaUnidadTerritorial) que incluye
  departamentos/partidos y ámbitos marítimos.
- Separación entre estado de vigencia y estado de modificación para evitar tratar
  "vigente" y "modificada" como estados mutuamente excluyentes.
- Se mantienen las distinciones entre sancionadaPor, promulgadaPor y emitidaPor.
- Se corrige la separación conceptual entre jurisdicción y unidad territorial.
- Se aclara que Alta Mar es un espacio marítimo, no un espacio bajo soberanía argentina.

IDIOMAS: castellano (@es) primario, inglés (@en) y portugués (@pt) para interoperabilidad.
"""@es .

# =====================================================================
# 1. VOCABULARIOS EXTERNOS
# =====================================================================

# AR-LEKO reutiliza términos publicados por SKOS y ELI mediante sus IRIs
# canónicas. No redeclara localmente esas clases ni propiedades, ni importa
# automáticamente sus axiomas. Esto evita crear definiciones locales que
# puedan divergir de las especificaciones originales.
# SKOS: https://www.w3.org/2004/02/skos/core#
# ELI:  http://data.europa.eu/eli/ontology#

# =====================================================================
# 2. CLASES
# =====================================================================

arleko:ObraJuridica a owl:Class ;
    rdfs:label "Obra jurídica"@es ;
    rdfs:label "Legal work"@en ;
    rdfs:label "Obra jurídica"@pt ;
    rdfs:comment "Superclase abstracta de las identidades estables que pueden ser modificadas, derogadas, referenciadas o versionadas."@es .

arleko:Norma a owl:Class ;
    rdfs:subClassOf arleko:ObraJuridica, eli:LegalResource ,
        [ a owl:Restriction ; owl:onProperty arleko:tipoNorma ; owl:someValuesFrom skos:Concept ] ,
        [ a owl:Restriction ; owl:onProperty arleko:jurisdiccion ; owl:someValuesFrom arleko:Jurisdiccion ] ;
    rdfs:label "Norma"@es ;
    rdfs:label "Norm"@en ;
    rdfs:label "Norma"@pt ;
    rdfs:comment "Instrumento jurídico como obra abstracta: Constitución, ley, código, decreto, resolución general, circular, comunicación, ordenanza. Para leyes, usar sancionadaPor (Congreso) y promulgadaPor (Ejecutivo); para actos administrativos, emitidaPor."@es .

arleko:UnidadNormativa a owl:Class ;
    rdfs:subClassOf arleko:ObraJuridica, eli:LegalResourceSubdivision ,
        [ a owl:Restriction ; owl:onProperty arleko:esHijoDe ; owl:someValuesFrom arleko:ObraJuridica ] ,
        [ a owl:Restriction ; owl:onProperty arleko:perteneceANorma ; owl:someValuesFrom arleko:Norma ] ,
        [ a owl:Restriction ; owl:onProperty arleko:tipoNivel ; owl:someValuesFrom skos:Concept ] ,
        [ a owl:Restriction ; owl:onProperty arleko:tieneVersion ; owl:someValuesFrom arleko:Version ] ;
    rdfs:label "Unidad normativa"@es ;
    rdfs:label "Normative unit"@en ;
    rdfs:label "Unidade normativa"@pt ;
    rdfs:comment "Cualquier subdivisión estructural de una Norma (libro, título, capítulo, artículo, inciso, anexo)."@es .

arleko:Version a owl:Class ;
    rdfs:subClassOf eli:LegalExpression ,
        [ a owl:Restriction ; owl:onProperty arleko:esVersionDe ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass arleko:ObraJuridica ] ;
    rdfs:label "Versión"@es ;
    rdfs:label "Version"@en ;
    rdfs:label "Versão"@pt ;
    rdfs:comment "Expresión de una ObraJuridica vigente en un intervalo [fechaDesde, fechaHasta)."@es .

arleko:VersionConsolidada a owl:Class ;
    rdfs:subClassOf arleko:Version ;
    rdfs:label "Versión consolidada"@es ;
    rdfs:label "Consolidated version"@en ;
    rdfs:label "Versão consolidada"@pt .

arleko:ActoModificatorio a owl:Class ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty arleko:obraActuante ; owl:someValuesFrom arleko:ObraJuridica ] ,
        [ a owl:Restriction ; owl:onProperty arleko:obraDestino ; owl:someValuesFrom arleko:ObraJuridica ] ,
        [ a owl:Restriction ; owl:onProperty arleko:tipoModificacion ; owl:someValuesFrom skos:Concept ] ;
    rdfs:label "Acto modificatorio"@es ;
    rdfs:label "Modification act"@en ;
    rdfs:label "Ato modificatório"@pt .

arleko:Referencia a owl:Class ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty arleko:fuenteReferencia ; owl:someValuesFrom arleko:ObraJuridica ] ,
        [ a owl:Restriction ; owl:onProperty arleko:tipoReferencia ; owl:someValuesFrom skos:Concept ] ;
    rdfs:label "Referencia"@es ;
    rdfs:label "Reference"@en ;
    rdfs:label "Referência"@pt .

arleko:EdicionBoletinOficial a owl:Class ;
    rdfs:label "Edición del Boletín Oficial"@es ;
    rdfs:label "Official Gazette issue"@en ;
    rdfs:label "Edição do Boletim Oficial"@pt .

arleko:OrganoEmisor a owl:Class ;
    rdfs:label "Órgano emisor"@es ;
    rdfs:label "Issuing body"@en ;
    rdfs:label "Órgão emissor"@pt ;
    rdfs:comment "Autoridad que dicta o emite una norma. Para actos legislativos (leyes), el Congreso/Legislatura sanciona; el Ejecutivo promulga. Para actos administrativos (resoluciones, comunicaciones), el organismo emite."@es .

arleko:Jurisdiccion a owl:Class ;
    rdfs:label "Jurisdicción"@es ;
    rdfs:label "Jurisdiction"@en ;
    rdfs:label "Jurisdição"@pt ;
    rdfs:comment "Orden jurídico territorial: Nación, provincia, CABA, municipio."@es .

arleko:SujetoRegulado a owl:Class ;
    rdfs:label "Sujeto regulado"@es ;
    rdfs:label "Regulated subject"@en ;
    rdfs:label "Sujeito regulado"@pt ;
    rdfs:comment "Destinatario de una norma: entidad financiera, contribuyente, sociedad, emisor de valores."@es .

arleko:UnidadTerritorial a owl:Class ;
    rdfs:label "Unidad territorial"@es ;
    rdfs:label "Territorial unit"@en ;
    rdfs:label "Unidade territorial"@pt ;
    rdfs:comment "División del territorio argentino con fines político-administrativos o judiciales. Su tipo se especifica con arleko:tipoUnidadTerritorial (lista restrictiva)."@es .

[] a owl:AllDisjointClasses ;
    owl:members ( arleko:Norma arleko:UnidadNormativa arleko:Version arleko:ActoModificatorio
                  arleko:Referencia arleko:EdicionBoletinOficial arleko:OrganoEmisor
                  arleko:SujetoRegulado ) .

# Jurisdiccion y UnidadTerritorial no se declaran disjuntas: una misma entidad
# (por ejemplo, una provincia) puede describirse como unidad territorial y como
# jurisdicción. Las clases representan aspectos conceptuales distintos.

# =====================================================================
# 3. PROPIEDADES DE OBJETO
# =====================================================================

# ---- 3.1 Estructura ---------------------------------------------------

arleko:esParteDe a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:subPropertyOf eli:is_part_of ;
    owl:inverseOf arleko:tieneParte ;
    rdfs:domain arleko:ObraJuridica ; rdfs:range arleko:ObraJuridica ;
    rdfs:label "es parte de"@es ; rdfs:label "is part of"@en ; rdfs:label "é parte de"@pt .

arleko:tieneParte a owl:ObjectProperty ;
    rdfs:subPropertyOf eli:has_part ;
    rdfs:label "tiene parte"@es ; rdfs:label "has part"@en ; rdfs:label "tem parte"@pt .

arleko:esHijoDe a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:subPropertyOf arleko:esParteDe ;
    owl:inverseOf arleko:tieneHijo ;
    rdfs:domain arleko:UnidadNormativa ; rdfs:range arleko:ObraJuridica ;
    rdfs:label "es hijo de"@es ; rdfs:label "is child of"@en ; rdfs:label "é filho de"@pt .

arleko:tieneHijo a owl:ObjectProperty ;
    rdfs:label "tiene hijo"@es ; rdfs:label "has child"@en ; rdfs:label "tem filho"@pt .

arleko:perteneceANorma a owl:ObjectProperty, owl:FunctionalProperty ;
    owl:inverseOf arleko:tieneUnidad ;
    rdfs:domain arleko:UnidadNormativa ; rdfs:range arleko:Norma ;
    rdfs:label "pertenece a norma"@es ; rdfs:label "belongs to norm"@en ; rdfs:label "pertence à norma"@pt .

arleko:tieneUnidad a owl:ObjectProperty ;
    rdfs:label "tiene unidad"@es ; rdfs:label "has unit"@en ; rdfs:label "tem unidade"@pt .

# ---- 3.2 Versionado --------------------------------------------------

arleko:esVersionDe a owl:ObjectProperty, owl:FunctionalProperty ;
    owl:inverseOf arleko:tieneVersion ;
    rdfs:domain arleko:Version ; rdfs:range arleko:ObraJuridica ;
    rdfs:label "es versión de"@es ; rdfs:label "is version of"@en ; rdfs:label "é versão de"@pt .

arleko:tieneVersion a owl:ObjectProperty ;
    rdfs:label "tiene versión"@es ; rdfs:label "has version"@en ; rdfs:label "tem versão"@pt .

arleko:versionAnterior a owl:ObjectProperty, owl:FunctionalProperty, owl:InverseFunctionalProperty ;
    owl:inverseOf arleko:versionSiguiente ;
    rdfs:domain arleko:Version ; rdfs:range arleko:Version ;
    rdfs:label "versión anterior"@es ; rdfs:label "previous version"@en ; rdfs:label "versão anterior"@pt .

arleko:versionSiguiente a owl:ObjectProperty ;
    rdfs:label "versión siguiente"@es ; rdfs:label "next version"@en ; rdfs:label "próxima versão"@pt .

arleko:tipoVersion a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain arleko:Version ; rdfs:range skos:Concept ;
    rdfs:label "tipo de versión"@es ; rdfs:label "version kind"@en ; rdfs:label "tipo de versão"@pt .

arleko:tieneEstadoLegal a owl:ObjectProperty ;
    rdfs:range skos:Concept ;
    rdfs:label "tiene estado legal"@es ; rdfs:label "has legal status"@en ; rdfs:label "tem estado legal"@pt ;
    rdfs:comment "Valor restringido al esquema arlekov:EsquemaEstadoLegal."@es .

arleko:estadoVigenciaActual a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:subPropertyOf arleko:tieneEstadoLegal ;
    rdfs:domain arleko:Norma ; rdfs:range skos:Concept ;
    rdfs:label "estado de vigencia actual"@es ;
    rdfs:label "current validity status"@en ;
    rdfs:label "estado de vigência atual"@pt ;
    rdfs:comment "Estado de vigencia de la norma. El valor debe pertenecer a arlekov:EsquemaEstadoLegal."@es .

arleko:estadoLegalActual a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:subPropertyOf arleko:estadoVigenciaActual ;
    rdfs:domain arleko:Norma ; rdfs:range skos:Concept ;
    rdfs:label "estado legal actual (compatibilidad)"@es ;
    rdfs:label "current legal status (compatibility)"@en ;
    rdfs:label "estado legal atual (compatibilidade)"@pt ;
    owl:deprecated true ;
    rdfs:comment "Propiedad heredada por compatibilidad. Para nuevos datos, utilizar estadoVigenciaActual y, cuando corresponda, estadoAplicacionActual y estadoModificacionActual."@es .

arleko:estadoAplicacionActual a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain arleko:Norma ; rdfs:range skos:Concept ;
    rdfs:label "estado de aplicación actual"@es ;
    rdfs:label "current applicability status"@en ;
    rdfs:label "estado de aplicação atual"@pt ;
    rdfs:comment "Indica si la aplicación de la norma está operativa o suspendida. El valor debe pertenecer a arlekov:EsquemaEstadoAplicacion."@es .

arleko:estadoModificacionActual a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain arleko:Norma ;
    rdfs:range skos:Concept ;
    rdfs:label "estado de modificación actual"@es ;
    rdfs:label "current amendment status"@en ;
    rdfs:label "estado de modificação atual"@pt ;
    rdfs:comment "Indica si la obra normativa ha sido modificada. El concepto debe pertenecer a arlekov:EsquemaEstadoModificacion. Es independiente del estado de vigencia."@es .

# ---- 3.3 Actos modificatorios ---------------------------------------

arleko:obraActuante a owl:ObjectProperty, owl:FunctionalProperty ;
    owl:inverseOf arleko:realizaActo ;
    rdfs:domain arleko:ActoModificatorio ; rdfs:range arleko:ObraJuridica ;
    rdfs:label "obra actuante"@es ; rdfs:label "acting work"@en ; rdfs:label "obra atuante"@pt .

arleko:realizaActo a owl:ObjectProperty ;
    rdfs:domain arleko:ObraJuridica ; rdfs:range arleko:ActoModificatorio ;
    rdfs:label "realiza acto"@es ; rdfs:label "performs act"@en ; rdfs:label "realiza ato"@pt .

arleko:obraDestino a owl:ObjectProperty, owl:FunctionalProperty ;
    owl:inverseOf arleko:afectadaPorActo ;
    rdfs:domain arleko:ActoModificatorio ; rdfs:range arleko:ObraJuridica ;
    rdfs:label "obra destino"@es ; rdfs:label "target work"@en ; rdfs:label "obra destino"@pt .

arleko:afectadaPorActo a owl:ObjectProperty ;
    rdfs:label "afectada por acto"@es ; rdfs:label "affected by act"@en ; rdfs:label "afetada por ato"@pt .

arleko:tipoModificacion a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain arleko:ActoModificatorio ; rdfs:range skos:Concept ;
    rdfs:label "tipo de modificación"@es ; rdfs:label "modification type"@en ; rdfs:label "tipo de modificação"@pt .

arleko:produceVersion a owl:ObjectProperty ;
    owl:inverseOf arleko:creadaPorActo ;
    rdfs:domain arleko:ActoModificatorio ; rdfs:range arleko:Version ;
    rdfs:label "produce versión"@es ; rdfs:label "produces version"@en ; rdfs:label "produz versão"@pt .

arleko:creadaPorActo a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "creada por acto"@es ; rdfs:label "created by act"@en ; rdfs:label "criada por ato"@pt .

arleko:cierraVersion a owl:ObjectProperty ;
    owl:inverseOf arleko:cerradaPorActo ;
    rdfs:domain arleko:ActoModificatorio ; rdfs:range arleko:Version ;
    rdfs:label "cierra versión"@es ; rdfs:label "closes version"@en ; rdfs:label "encerra versão"@pt .

arleko:cerradaPorActo a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "cerrada por acto"@es ; rdfs:label "closed by act"@en ; rdfs:label "encerrada por ato"@pt .

# ---- 3.4 Relaciones directas entre obras ---------------------------

arleko:modifica a owl:ObjectProperty ;
    owl:inverseOf arleko:modificadaPor ;
    owl:propertyChainAxiom ( arleko:realizaActo arleko:obraDestino ) ;
    rdfs:domain arleko:ObraJuridica ; rdfs:range arleko:ObraJuridica ;
    rdfs:label "modifica"@es ; rdfs:label "modifies"@en ; rdfs:label "modifica"@pt .

arleko:modificadaPor a owl:ObjectProperty ;
    rdfs:label "modificada por"@es ; rdfs:label "modified by"@en ; rdfs:label "modificada por"@pt .

arleko:enmienda a owl:ObjectProperty ;
    rdfs:subPropertyOf arleko:modifica, eli:amends ;
    owl:inverseOf arleko:enmendadaPor ;
    rdfs:label "enmienda"@es ; rdfs:label "amends"@en ; rdfs:label "emenda"@pt .

arleko:enmendadaPor a owl:ObjectProperty ;
    rdfs:label "enmendada por"@es ; rdfs:label "amended by"@en ; rdfs:label "emendada por"@pt .

arleko:deroga a owl:ObjectProperty ;
    rdfs:subPropertyOf arleko:modifica, eli:repeals ;
    owl:inverseOf arleko:derogadaPor ;
    rdfs:label "deroga"@es ; rdfs:label "repeals"@en ; rdfs:label "revoga"@pt .

arleko:derogadaPor a owl:ObjectProperty ;
    rdfs:label "derogada por"@es ; rdfs:label "repealed by"@en ; rdfs:label "revogada por"@pt .

arleko:reemplaza a owl:ObjectProperty ;
    rdfs:subPropertyOf arleko:modifica ;
    owl:inverseOf arleko:reemplazadaPor ;
    rdfs:label "reemplaza"@es ; rdfs:label "replaces"@en ; rdfs:label "substitui"@pt .

arleko:reemplazadaPor a owl:ObjectProperty ;
    rdfs:label "reemplazada por"@es ; rdfs:label "replaced by"@en ; rdfs:label "substituída por"@pt .

arleko:suspende a owl:ObjectProperty ;
    rdfs:subPropertyOf arleko:modifica ;
    owl:inverseOf arleko:suspendidaPor ;
    rdfs:label "suspende"@es ; rdfs:label "suspends"@en ; rdfs:label "suspende"@pt .

arleko:suspendidaPor a owl:ObjectProperty ;
    rdfs:label "suspendida por"@es ; rdfs:label "suspended by"@en ; rdfs:label "suspensa por"@pt .

arleko:corrige a owl:ObjectProperty ;
    rdfs:subPropertyOf arleko:modifica, eli:corrects ;
    owl:inverseOf arleko:corregidaPor ;
    rdfs:label "corrige"@es ; rdfs:label "corrects"@en ; rdfs:label "corrige"@pt .

arleko:corregidaPor a owl:ObjectProperty ;
    rdfs:label "corregida por"@es ; rdfs:label "corrected by"@en ; rdfs:label "corrigida por"@pt .

arleko:reglamenta a owl:ObjectProperty ;
    owl:inverseOf arleko:reglamentadaPor ;
    rdfs:domain arleko:ObraJuridica ; rdfs:range arleko:ObraJuridica ;
    rdfs:label "reglamenta"@es ; rdfs:label "regulates"@en ; rdfs:label "regulamenta"@pt .

arleko:reglamentadaPor a owl:ObjectProperty ;
    rdfs:label "reglamentada por"@es ; rdfs:label "regulated by"@en ; rdfs:label "regulamentada por"@pt .

arleko:seFundaEn a owl:ObjectProperty ;
    rdfs:subPropertyOf eli:based_on ;
    owl:inverseOf arleko:esFundamentoDe ;
    rdfs:domain arleko:ObraJuridica ; rdfs:range arleko:ObraJuridica ;
    rdfs:label "se funda en"@es ; rdfs:label "based on"@en ; rdfs:label "fundamenta-se em"@pt .

arleko:esFundamentoDe a owl:ObjectProperty ;
    rdfs:label "es fundamento de"@es ; rdfs:label "basis for"@en ; rdfs:label "é fundamento de"@pt .

arleko:refiereA a owl:ObjectProperty ;
    rdfs:subPropertyOf eli:cites ;
    owl:inverseOf arleko:referidaPor ;
    rdfs:domain arleko:ObraJuridica ; rdfs:range arleko:ObraJuridica ;
    rdfs:label "refiere a"@es ; rdfs:label "refers to"@en ; rdfs:label "refere-se a"@pt .

arleko:referidaPor a owl:ObjectProperty ;
    rdfs:label "referida por"@es ; rdfs:label "referred to by"@en ; rdfs:label "referida por"@pt .

# ---- 3.5 Referencias -------------------------------------------------

arleko:fuenteReferencia a owl:ObjectProperty, owl:FunctionalProperty ;
    owl:inverseOf arleko:tieneReferencia ;
    rdfs:domain arleko:Referencia ; rdfs:range arleko:ObraJuridica ;
    rdfs:label "fuente de referencia"@es ; rdfs:label "reference source"@en ; rdfs:label "fonte de referência"@pt .

arleko:tieneReferencia a owl:ObjectProperty ;
    rdfs:domain arleko:ObraJuridica ; rdfs:range arleko:Referencia ;
    rdfs:label "tiene referencia"@es ; rdfs:label "has reference"@en ; rdfs:label "tem referência"@pt .

arleko:versionFuenteReferencia a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain arleko:Referencia ; rdfs:range arleko:Version ;
    rdfs:label "versión fuente de referencia"@es ; rdfs:label "reference source version"@en ; rdfs:label "versão fonte de referência"@pt .

arleko:destinoReferencia a owl:ObjectProperty ;
    owl:inverseOf arleko:objetoDeReferencia ;
    rdfs:domain arleko:Referencia ; rdfs:range arleko:ObraJuridica ;
    rdfs:label "destino de referencia"@es ; rdfs:label "reference target"@en ; rdfs:label "destino de referência"@pt .

arleko:objetoDeReferencia a owl:ObjectProperty ;
    rdfs:label "objeto de referencia"@es ; rdfs:label "target of reference"@en ; rdfs:label "objeto de referência"@pt .

arleko:versionDestinoReferencia a owl:ObjectProperty ;
    rdfs:domain arleko:Referencia ; rdfs:range arleko:Version ;
    rdfs:label "versión destino de referencia"@es ; rdfs:label "reference target version"@en ; rdfs:label "versão destino de referência"@pt .

arleko:tipoReferencia a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain arleko:Referencia ; rdfs:range skos:Concept ;
    rdfs:label "tipo de referencia"@es ; rdfs:label "reference type"@en ; rdfs:label "tipo de referência"@pt .

arleko:modoReferencia a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain arleko:Referencia ; rdfs:range skos:Concept ;
    rdfs:label "modo de referencia"@es ; rdfs:label "reference mode"@en ; rdfs:label "modo de referência"@pt .

# ---- 3.6 Clasificación, contexto, publicación ------------------------

arleko:tipoNorma a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:subPropertyOf eli:type_document ;
    rdfs:domain arleko:Norma ; rdfs:range skos:Concept ;
    rdfs:label "tipo de norma"@es ; rdfs:label "norm type"@en ; rdfs:label "tipo de norma"@pt .

arleko:tipoNivel a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain arleko:UnidadNormativa ; rdfs:range skos:Concept ;
    rdfs:label "tipo de nivel"@es ; rdfs:label "level type"@en ; rdfs:label "tipo de nível"@pt .

arleko:materia a owl:ObjectProperty ;
    rdfs:subPropertyOf eli:is_about ;
    rdfs:domain arleko:ObraJuridica, arleko:UnidadNormativa ;
    rdfs:range skos:Concept ;
    rdfs:label "materia"@es ; rdfs:label "subject matter"@en ; rdfs:label "matéria"@pt .

arleko:jurisdiccion a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( arleko:Norma arleko:OrganoEmisor arleko:EdicionBoletinOficial ) ] ;
    rdfs:range arleko:Jurisdiccion ;
    rdfs:label "jurisdicción"@es ; rdfs:label "jurisdiction"@en ; rdfs:label "jurisdição"@pt .

arleko:jurisdiccionPadre a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain arleko:Jurisdiccion ; rdfs:range arleko:Jurisdiccion ;
    rdfs:label "jurisdicción padre"@es ; rdfs:label "parent jurisdiction"@en ; rdfs:label "jurisdição pai"@pt .

arleko:nivelJurisdiccion a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain arleko:Jurisdiccion ; rdfs:range skos:Concept ;
    rdfs:label "nivel de jurisdicción"@es ; rdfs:label "jurisdiction level"@en ; rdfs:label "nível de jurisdição"@pt .

arleko:emitidaPor a owl:ObjectProperty ;
    rdfs:domain arleko:Norma ; rdfs:range arleko:OrganoEmisor ;
    rdfs:label "emitida por"@es ; rdfs:label "issued by"@en ; rdfs:label "emitida por"@pt ;
    rdfs:comment "Para actos administrativos (resoluciones, comunicaciones, disposiciones). Para leyes, usar sancionadaPor y promulgadaPor."@es .

arleko:sancionadaPor a owl:ObjectProperty ;
    rdfs:domain arleko:Norma ; rdfs:range arleko:OrganoEmisor ;
    rdfs:label "sancionada por"@es ; rdfs:label "sanctioned by"@en ; rdfs:label "sancionada por"@pt ;
    rdfs:comment "Cuerpo legislativo que sanciona la ley: Congreso Nacional (Diputados y Senadores), Legislatura Provincial, Concejo Deliberante. Conforme arts. 77-84 CN."@es .

arleko:promulgadaPor a owl:ObjectProperty ;
    rdfs:domain arleko:Norma ; rdfs:range arleko:OrganoEmisor ;
    rdfs:label "promulgada por"@es ; rdfs:label "promulgated by"@en ; rdfs:label "promulgada por"@pt ;
    rdfs:comment "Poder Ejecutivo que promulga la ley (expresa o tácitamente), conforme arts. 78 y 80 CN."@es .

arleko:publicadaEn a owl:ObjectProperty ;
    rdfs:domain arleko:Norma ; rdfs:range arleko:EdicionBoletinOficial ;
    rdfs:label "publicada en"@es ; rdfs:label "published in"@en ; rdfs:label "publicada em"@pt .

arleko:modoPromulgacion a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain arleko:Norma ; rdfs:range skos:Concept ;
    rdfs:label "modo de promulgación"@es ; rdfs:label "promulgation mode"@en ; rdfs:label "modo de promulgação"@pt .

arleko:estadoVerificacion a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:range skos:Concept ;
    rdfs:label "estado de verificación"@es ; rdfs:label "verification status"@en ; rdfs:label "estado de verificação"@pt .

arleko:puedeModificarTipoNorma a owl:ObjectProperty ;
    rdfs:domain skos:Concept ; rdfs:range skos:Concept ;
    rdfs:label "puede modificar tipo de norma"@es ; rdfs:label "may modify norm type"@en ; rdfs:label "pode modificar tipo de norma"@pt .

arleko:puedeModificarTipoNormaCondicional a owl:ObjectProperty ;
    rdfs:domain skos:Concept ; rdfs:range skos:Concept ;
    rdfs:label "puede modificar tipo de norma condicionalmente"@es ;
    rdfs:label "may modify norm type conditionally"@en ;
    rdfs:label "pode modificar tipo de norma condicionalmente"@pt .

arleko:puedeContenerNivel a owl:ObjectProperty ;
    rdfs:domain skos:Concept ; rdfs:range skos:Concept ;
    rdfs:label "puede contener nivel"@es ; rdfs:label "may contain level"@en ; rdfs:label "pode conter nível"@pt .

# ---- 3.7 Sujetos regulados y órganos --------------------------------

arleko:sujetoDestinatario a owl:ObjectProperty ;
    rdfs:domain arleko:Norma ; rdfs:range arleko:SujetoRegulado ;
    rdfs:label "sujeto destinatario"@es ; rdfs:label "addressee"@en ; rdfs:label "sujeito destinatário"@pt .

arleko:tipoSujeto a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain arleko:SujetoRegulado ; rdfs:range skos:Concept ;
    rdfs:label "tipo de sujeto"@es ; rdfs:label "subject type"@en ; rdfs:label "tipo de sujeito"@pt .

arleko:tipoOrgano a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain arleko:OrganoEmisor ; rdfs:range skos:Concept ;
    rdfs:label "tipo de órgano"@es ; rdfs:label "body type"@en ; rdfs:label "tipo de órgão"@pt .

arleko:organismoPadre a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain arleko:OrganoEmisor ; rdfs:range arleko:OrganoEmisor ;
    rdfs:label "organismo padre"@es ; rdfs:label "parent body"@en ; rdfs:label "órgão pai"@pt .

arleko:predecesorOrgano a owl:ObjectProperty, owl:FunctionalProperty ;
    owl:inverseOf arleko:sucesorOrgano ;
    rdfs:domain arleko:OrganoEmisor ; rdfs:range arleko:OrganoEmisor ;
    rdfs:label "predecesor"@es ; rdfs:label "predecessor"@en ; rdfs:label "predecessor"@pt .

arleko:sucesorOrgano a owl:ObjectProperty ;
    rdfs:label "sucesor"@es ; rdfs:label "successor"@en ; rdfs:label "sucessor"@pt .

arleko:alcanceNorma a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain arleko:Norma ; rdfs:range skos:Concept ;
    rdfs:label "alcance de la norma"@es ; rdfs:label "scope of the norm"@en ; rdfs:label "alcance da norma"@pt .

# ---- 3.8 Unidades territoriales (nuevo) ----------------------------

arleko:tipoUnidadTerritorial a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain arleko:UnidadTerritorial ; rdfs:range skos:Concept ;
    rdfs:label "tipo de unidad territorial"@es ;
    rdfs:label "territorial unit type"@en ;
    rdfs:label "tipo de unidade territorial"@pt ;
    rdfs:comment "Valor restringido al esquema arlekov:EsquemaUnidadTerritorial (lista taxativa)."@es .

arleko:unidadTerritorialPadre a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain arleko:UnidadTerritorial ; rdfs:range arleko:UnidadTerritorial ;
    rdfs:label "unidad territorial padre"@es ;
    rdfs:label "parent territorial unit"@en ;
    rdfs:label "unidade territorial pai"@pt ;
    rdfs:comment "Jerarquía: Municipio -> Departamento/Partido -> Provincia -> Nación."@es .

arleko:ambitoTerritorial a owl:ObjectProperty ;
    rdfs:domain arleko:Norma ;
    rdfs:range skos:Concept ;
    rdfs:label "ámbito territorial"@es ;
    rdfs:label "territorial scope"@en ;
    rdfs:label "âmbito territorial"@pt ;
    rdfs:comment "Ámbito espacial de aplicación de la norma. Los conceptos marítimos describen espacios geográficos y no implican por sí mismos soberanía o jurisdicción argentina. Valores controlados en arlekov:EsquemaAmbitoMaritimo."@es .

# =====================================================================
# 4. PROPIEDADES DE DATOS
# =====================================================================

# ---- 4.1 Identificación y fechas de la norma ------------------------

arleko:identificadorLocal a owl:DatatypeProperty ;
    rdfs:subPropertyOf eli:id_local ;
    rdfs:domain arleko:ObraJuridica ; rdfs:range xsd:string ;
    rdfs:label "identificador local"@es ; rdfs:label "local identifier"@en ; rdfs:label "identificador local"@pt .

arleko:designacionOficial a owl:DatatypeProperty ;
    rdfs:domain arleko:Norma ; rdfs:range xsd:string ;
    rdfs:label "designación oficial"@es ; rdfs:label "official designation"@en ; rdfs:label "designação oficial"@pt .

arleko:numeroNorma a owl:DatatypeProperty ;
    rdfs:domain arleko:Norma ; rdfs:range xsd:string ;
    rdfs:label "número de norma"@es ; rdfs:label "norm number"@en ; rdfs:label "número da norma"@pt .

arleko:anioNorma a owl:DatatypeProperty ;
    rdfs:domain arleko:Norma ; rdfs:range xsd:gYear ;
    rdfs:label "año de la norma"@es ; rdfs:label "norm year"@en ; rdfs:label "ano da norma"@pt .

arleko:titulo a owl:DatatypeProperty ;
    rdfs:subPropertyOf eli:title ;
    rdfs:domain arleko:Norma ; rdfs:range rdfs:Literal ;
    rdfs:label "título"@es ; rdfs:label "title"@en ; rdfs:label "título"@pt .

arleko:tituloCorto a owl:DatatypeProperty ;
    rdfs:subPropertyOf eli:title_short ;
    rdfs:domain arleko:Norma ; rdfs:range rdfs:Literal ;
    rdfs:label "título corto"@es ; rdfs:label "short title"@en ; rdfs:label "título curto"@pt .

arleko:nombrePopular a owl:DatatypeProperty ;
    rdfs:domain arleko:Norma ; rdfs:range rdfs:Literal ;
    rdfs:label "nombre popular"@es ; rdfs:label "popular name"@en ; rdfs:label "nome popular"@pt .

arleko:descripcion a owl:DatatypeProperty ;
    rdfs:domain arleko:Norma ; rdfs:range rdfs:Literal ;
    rdfs:label "descripción"@es ; rdfs:label "description"@en ; rdfs:label "descrição"@pt .

arleko:resumenEjecutivo a owl:DatatypeProperty ;
    rdfs:domain arleko:Norma ; rdfs:range rdfs:Literal ;
    rdfs:label "resumen ejecutivo"@es ; rdfs:label "executive summary"@en ; rdfs:label "resumo executivo"@pt .

arleko:fechaNorma a owl:DatatypeProperty ;
    rdfs:domain arleko:Norma ; rdfs:range xsd:date ;
    rdfs:label "fecha de la norma"@es ; rdfs:label "norm date"@en ; rdfs:label "data da norma"@pt .

arleko:fechaSancion a owl:DatatypeProperty ;
    rdfs:subPropertyOf arleko:fechaNorma ;
    rdfs:domain arleko:Norma ; rdfs:range xsd:date ;
    rdfs:label "fecha de sanción"@es ; rdfs:label "date sanctioned"@en ; rdfs:label "data de sanção"@pt .

arleko:fechaPromulgada a owl:DatatypeProperty ;
    rdfs:domain arleko:Norma ; rdfs:range xsd:date ;
    rdfs:label "fecha de promulgación"@es ; rdfs:label "date promulgated"@en ; rdfs:label "data de promulgação"@pt .

arleko:fechaDictada a owl:DatatypeProperty ;
    rdfs:subPropertyOf arleko:fechaNorma, eli:date_document ;
    rdfs:domain arleko:Norma ; rdfs:range xsd:date ;
    rdfs:label "fecha de dictado"@es ; rdfs:label "date issued"@en ; rdfs:label "data de expedição"@pt .

arleko:fechaPublicacion a owl:DatatypeProperty ;
    rdfs:subPropertyOf eli:date_publication ;
    rdfs:domain arleko:Norma ; rdfs:range xsd:date ;
    rdfs:label "fecha de publicación"@es ; rdfs:label "date published"@en ; rdfs:label "data de publicação"@pt .

arleko:fechaEntradaVigencia a owl:DatatypeProperty ;
    rdfs:subPropertyOf eli:first_date_entry_in_force ;
    rdfs:domain arleko:Norma ; rdfs:range xsd:date ;
    rdfs:label "fecha de entrada en vigencia"@es ; rdfs:label "entry into force date"@en ; rdfs:label "data de entrada em vigor"@pt .

arleko:fechaCeseVigencia a owl:DatatypeProperty ;
    rdfs:subPropertyOf eli:date_no_longer_in_force ;
    rdfs:domain arleko:Norma ; rdfs:range xsd:date ;
    rdfs:label "fecha de cese de vigencia"@es ; rdfs:label "end of force date"@en ; rdfs:label "data de cessação de vigor"@pt .

arleko:fechaVeto a owl:DatatypeProperty ;
    rdfs:domain arleko:Norma ; rdfs:range xsd:date ;
    rdfs:label "fecha de veto"@es ; rdfs:label "veto date"@en ; rdfs:label "data de veto"@pt .

arleko:fechaFirmaTratado a owl:DatatypeProperty ;
    rdfs:subPropertyOf arleko:fechaNorma ;
    rdfs:domain arleko:Norma ; rdfs:range xsd:date ;
    rdfs:label "fecha de firma del tratado"@es ; rdfs:label "treaty signature date"@en ; rdfs:label "data de assinatura do tratado"@pt .

arleko:fechaRatificacion a owl:DatatypeProperty ;
    rdfs:domain arleko:Norma ; rdfs:range xsd:date ;
    rdfs:label "fecha de ratificación"@es ; rdfs:label "ratification date"@en ; rdfs:label "data de ratificação"@pt .

arleko:identificadorExterno a owl:DatatypeProperty ;
    rdfs:domain arleko:ObraJuridica ; rdfs:range xsd:string ;
    rdfs:label "identificador externo"@es ; rdfs:label "external identifier"@en ; rdfs:label "identificador externo"@pt .

arleko:idInfoLEG a owl:DatatypeProperty ;
    rdfs:subPropertyOf arleko:identificadorExterno ;
    rdfs:domain arleko:ObraJuridica ; rdfs:range xsd:string ;
    rdfs:label "identificador InfoLEG"@es ; rdfs:label "InfoLEG identifier"@en ; rdfs:label "identificador InfoLEG"@pt .

arleko:idSAIJ a owl:DatatypeProperty ;
    rdfs:subPropertyOf arleko:identificadorExterno ;
    rdfs:domain arleko:ObraJuridica ; rdfs:range xsd:string ;
    rdfs:label "identificador SAIJ"@es ; rdfs:label "SAIJ identifier"@en ; rdfs:label "identificador SAIJ"@pt .

