# ---- 5.5 Estado legal (LISTA TAXATIVA) ------------------------------

arlekov:EsquemaEstadoLegal a skos:ConceptScheme ;
    skos:prefLabel "Estado legal"@es ;
    skos:prefLabel "Legal status"@en ;
    skos:prefLabel "Estado legal"@pt ;
    skos:definition "Vocabulario controlado para el estado de vigencia de una norma. La suspensión de aplicación y la condición de modificada se representan en esquemas separados."@es .

arlekov:EstadoLegal-Vigente a skos:Concept ; skos:inScheme arlekov:EsquemaEstadoLegal ;
    skos:prefLabel "Vigente"@es ; skos:prefLabel "In force"@en ; skos:prefLabel "Vigente"@pt ;
    skos:definition "La norma produce plenos efectos jurídicos."@es .
arlekov:EstadoLegal-Derogada a skos:Concept ; skos:inScheme arlekov:EsquemaEstadoLegal ;
    skos:prefLabel "Derogada"@es ; skos:prefLabel "Repealed"@en ; skos:prefLabel "Revogada"@pt ;
    skos:definition "La norma ha cesado en su vigencia por efecto de una disposición posterior. Los efectos temporales de la derogación y las reglas transitorias dependen del régimen jurídico aplicable."@es .
# El estado de modificación se modela en un esquema separado del estado de vigencia.
arlekov:EsquemaEstadoModificacion a skos:ConceptScheme ;
    skos:prefLabel "Estado de modificación"@es ;
    skos:prefLabel "Amendment status"@en ;
    skos:prefLabel "Estado de modificação"@pt ;
    skos:definition "Indica si la obra normativa ha sufrido modificaciones, con independencia de que continúe vigente."@es .

arlekov:EstadoModificacion-Modificada a skos:Concept ; skos:inScheme arlekov:EsquemaEstadoModificacion ;
    skos:prefLabel "Modificada"@es ; skos:prefLabel "Amended"@en ; skos:prefLabel "Modificada"@pt ;
    skos:definition "La obra normativa ha sido alterada total o parcialmente por uno o más actos posteriores. Este estado no determina por sí solo si la norma está vigente, derogada o suspendida."@es .

arlekov:EstadoModificacion-NoModificada a skos:Concept ; skos:inScheme arlekov:EsquemaEstadoModificacion ;
    skos:prefLabel "No modificada"@es ; skos:prefLabel "Unamended"@en ; skos:prefLabel "Não modificada"@pt ;
    skos:definition "No se han identificado actos modificatorios aplicables a la obra normativa."@es .
arlekov:EsquemaEstadoAplicacion a skos:ConceptScheme ;
    skos:prefLabel "Estado de aplicación"@es ;
    skos:prefLabel "Applicability status"@en ;
    skos:prefLabel "Estado de aplicação"@pt ;
    skos:definition "Vocabulario controlado para describir si la aplicación de una norma está operativa o suspendida, con independencia de su vigencia formal."@es .

arlekov:EstadoAplicacion-Aplicable a skos:Concept ; skos:inScheme arlekov:EsquemaEstadoAplicacion ;
    skos:prefLabel "Aplicable"@es ; skos:prefLabel "Applicable"@en ; skos:prefLabel "Aplicável"@pt ;
    skos:definition "La aplicación de la norma no está marcada como suspendida en los datos disponibles."@es .
arlekov:EstadoAplicacion-Suspendida a skos:Concept ; skos:inScheme arlekov:EsquemaEstadoAplicacion ;
    skos:prefLabel "Suspendida"@es ; skos:prefLabel "Suspended"@en ; skos:prefLabel "Suspensa"@pt ;
    skos:definition "La aplicación de la norma está temporalmente suspendida, sin que ello implique por sí mismo su derogación o pérdida de vigencia formal."@es .
arlekov:EstadoLegal-Anulada a skos:Concept ; skos:inScheme arlekov:EsquemaEstadoLegal ;
    skos:prefLabel "Anulada"@es ; skos:prefLabel "Annulled"@en ; skos:prefLabel "Anulada"@pt ;
    skos:definition "La norma ha sido declarada nula por autoridad competente. El alcance temporal y los efectos de la nulidad dependen de la decisión y del régimen jurídico aplicable."@es .
arlekov:EstadoLegal-Caduca a skos:Concept ; skos:inScheme arlekov:EsquemaEstadoLegal ;
    skos:prefLabel "Caduca / agotada"@es ; skos:prefLabel "Expired"@en ; skos:prefLabel "Caduca / esgotada"@pt ;
    skos:definition "La norma ha agotado su objeto o ha vencido el plazo para el que fue dictada."@es .
arlekov:EstadoLegal-PendienteDeVigencia a skos:Concept ; skos:inScheme arlekov:EsquemaEstadoLegal ;
    skos:prefLabel "Pendiente de entrada en vigencia"@es ; skos:prefLabel "Not yet in force"@en ; skos:prefLabel "Pendente de entrada em vigor"@pt ;
    skos:definition "La norma ha sido aprobada o dictada, pero su entrada en vigencia está diferida o sujeta a una condición futura."@es .

