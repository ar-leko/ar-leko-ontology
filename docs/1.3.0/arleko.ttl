arleko:periodoFiscal a owl:DatatypeProperty ;
    rdfs:domain arleko:Norma ; rdfs:range xsd:string ;
    rdfs:label "período fiscal"@es ; rdfs:label "fiscal period"@en ; rdfs:label "período fiscal"@pt .

arleko:urlPublicacion a owl:DatatypeProperty ;
    rdfs:domain arleko:Norma ; rdfs:range xsd:anyURI ;
    rdfs:label "URL de publicación"@es ; rdfs:label "publication URL"@en ; rdfs:label "URL de publicação"@pt .

# =====================================================================
# 5. VOCABULARIOS CONTROLADOS (SKOS)
# =====================================================================

# ---- 5.1 Tipos de norma ----------------------------------------------

arlekov:EsquemaTipoNorma a skos:ConceptScheme ;
    skos:prefLabel "Tipos de norma"@es ;
    skos:prefLabel "Norm types"@en ;
    skos:prefLabel "Tipos de norma"@pt .

arlekov:TipoNorma-Constitucion a skos:Concept ; skos:inScheme arlekov:EsquemaTipoNorma ;
    skos:prefLabel "Constitución"@es ; skos:prefLabel "Constitution"@en ; skos:prefLabel "Constituição"@pt ;
    arleko:rangoJerarquico 1 .
arlekov:TipoNorma-TratadoDDHH a skos:Concept ; skos:inScheme arlekov:EsquemaTipoNorma ;
    skos:prefLabel "Tratado de derechos humanos con jerarquía constitucional"@es ;
    skos:prefLabel "Human rights treaty with constitutional rank"@en ;
    skos:prefLabel "Tratado de direitos humanos com hierarquia constitucional"@pt ;
    arleko:rangoJerarquico 2 .
arlekov:TipoNorma-TratadoIntegracion a skos:Concept ; skos:inScheme arlekov:EsquemaTipoNorma ;
    skos:prefLabel "Tratado de integración"@es ; skos:prefLabel "Integration treaty"@en ; skos:prefLabel "Tratado de integração"@pt ;
    arleko:rangoJerarquico 3 .
arlekov:TipoNorma-Tratado a skos:Concept ; skos:inScheme arlekov:EsquemaTipoNorma ;
