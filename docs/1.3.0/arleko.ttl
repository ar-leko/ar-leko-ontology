arleko:fechaDesde a owl:DatatypeProperty ;
    rdfs:domain arleko:Version ; rdfs:range xsd:date ;
    rdfs:label "fecha desde"@es ; rdfs:label "date from"@en ; rdfs:label "data de início"@pt .

arleko:fechaHasta a owl:DatatypeProperty ;
    rdfs:domain arleko:Version ; rdfs:range xsd:date ;
    rdfs:label "fecha hasta"@es ; rdfs:label "date until"@en ; rdfs:label "data de fim"@pt .

arleko:texto a owl:DatatypeProperty ;
    rdfs:domain arleko:Version ; rdfs:range rdfs:Literal ;
    rdfs:label "texto"@es ; rdfs:label "text"@en ; rdfs:label "texto"@pt .

arleko:epigrafe a owl:DatatypeProperty ;
    rdfs:domain arleko:Version ; rdfs:range rdfs:Literal ;
    rdfs:label "epígrafe"@es ; rdfs:label "heading"@en ; rdfs:label "epígrafe"@pt .

arleko:etiquetaNumero a owl:DatatypeProperty ;
    rdfs:domain arleko:Version ; rdfs:range xsd:string ;
    rdfs:label "etiqueta de número"@es ; rdfs:label "number label"@en ; rdfs:label "etiqueta de número"@pt .

arleko:numeroBase a owl:DatatypeProperty ;
    rdfs:domain arleko:Version ; rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "número base"@es ; rdfs:label "number base"@en ; rdfs:label "número base"@pt .

arleko:sufijoNumero a owl:DatatypeProperty ;
    rdfs:domain arleko:Version ; rdfs:range xsd:string ;
    rdfs:label "sufijo de número"@es ; rdfs:label "number suffix"@en ; rdfs:label "sufixo de número"@pt .

arleko:posicion a owl:DatatypeProperty ;
    rdfs:domain arleko:Version ; rdfs:range xsd:positiveInteger ;
    rdfs:label "posición"@es ; rdfs:label "position"@en ; rdfs:label "posição"@pt .

arleko:documentoFuente a owl:DatatypeProperty ;
    rdfs:domain arleko:Version ;
    rdfs:range xsd:anyURI ;
    rdfs:label "documento fuente"@es ; rdfs:label "source document"@en ; rdfs:label "documento fonte"@pt .

arleko:esTextoOrdenado a owl:DatatypeProperty ;
    rdfs:domain arleko:Version ; rdfs:range xsd:boolean ;
    rdfs:label "es texto ordenado"@es ; rdfs:label "is consolidated text"@en ; rdfs:label "é texto consolidado"@pt .

# ---- 4.3 Actos y referencias ----------------------------------------

arleko:vigenteDesde a owl:DatatypeProperty ;
    rdfs:domain arleko:ActoModificatorio ; rdfs:range xsd:date ;
    rdfs:label "vigente desde"@es ; rdfs:label "effective from"@en ; rdfs:label "vigente desde"@pt .

arleko:textoEvidencia a owl:DatatypeProperty ;
    rdfs:domain arleko:ActoModificatorio ; rdfs:range rdfs:Literal ;
    rdfs:label "texto de evidencia"@es ; rdfs:label "evidence text"@en ; rdfs:label "texto de evidência"@pt .

arleko:textoAncla a owl:DatatypeProperty ;
    rdfs:domain arleko:Referencia ; rdfs:range rdfs:Literal ;
    rdfs:label "texto ancla"@es ; rdfs:label "anchor text"@en ; rdfs:label "texto âncora"@pt .

arleko:estaResuelta a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain arleko:Referencia ; rdfs:range xsd:boolean ;
    rdfs:label "está resuelta"@es ; rdfs:label "is resolved"@en ; rdfs:label "está resolvida"@pt .

arleko:textoDestinoNoResuelto a owl:DatatypeProperty ;
    rdfs:domain arleko:Referencia ; rdfs:range rdfs:Literal ;
    rdfs:label "texto de destino no resuelto"@es ; rdfs:label "unresolved target text"@en ; rdfs:label "texto de destino não resolvido"@pt .

arleko:confianzaExtraccion a owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Confianza asociada a un dato extraído automáticamente. Se omite deliberadamente el dominio para permitir su uso sobre distintos recursos o anotaciones de extracción; se recomienda restringirlo mediante SHACL en cada perfil de datos."@es ;
    rdfs:label "confianza de extracción"@es ; rdfs:label "extraction confidence"@en ; rdfs:label "confiança de extração"@pt .

# ---- 4.4 Boletín y anotaciones de vocabulario -----------------------

arleko:nombreBoletin a owl:DatatypeProperty ;
    rdfs:domain arleko:EdicionBoletinOficial ; rdfs:range xsd:string ;
    rdfs:label "nombre del boletín"@es ; rdfs:label "gazette name"@en ; rdfs:label "nome do boletim"@pt .

arleko:numeroEdicion a owl:DatatypeProperty ;
    rdfs:domain arleko:EdicionBoletinOficial ; rdfs:range xsd:string ;
    rdfs:label "número de edición"@es ; rdfs:label "issue number"@en ; rdfs:label "número da edição"@pt .

arleko:fechaEdicion a owl:DatatypeProperty ;
    rdfs:domain arleko:EdicionBoletinOficial ; rdfs:range xsd:date ;
    rdfs:label "fecha de edición"@es ; rdfs:label "issue date"@en ; rdfs:label "data da edição"@pt .

arleko:fechaAplicable a owl:AnnotationProperty ;
    rdfs:label "fecha aplicable"@es ; rdfs:label "applicable date"@en ; rdfs:label "data aplicável"@pt .

arleko:fechaRequerida a owl:AnnotationProperty ;
    rdfs:label "fecha requerida"@es ; rdfs:label "required date"@en ; rdfs:label "data exigida"@pt .

arleko:rangoJerarquico a owl:DatatypeProperty ;
    rdfs:domain skos:Concept ; rdfs:range xsd:integer ;
    rdfs:label "rango jerárquico"@es ; rdfs:label "hierarchy rank"@en ; rdfs:label "ranking hierárquico"@pt .

arleko:puedeSerNivelRaiz a owl:DatatypeProperty ;
    rdfs:domain skos:Concept ; rdfs:range xsd:boolean ;
    rdfs:label "puede ser nivel raíz"@es ; rdfs:label "may be root level"@en ; rdfs:label "pode ser nível raiz"@pt .

arleko:esTratadoDDHH a owl:DatatypeProperty ;
    rdfs:domain arleko:Norma ; rdfs:range xsd:boolean ;
    rdfs:label "es tratado de DDHH"@es ; rdfs:label "is human rights treaty"@en ; rdfs:label "é tratado de direitos humanos"@pt .

# ---- 4.5 Órganos emisores ------------------------------------------

arleko:denominacionAnterior a owl:DatatypeProperty ;
    rdfs:domain arleko:OrganoEmisor ; rdfs:range xsd:string ;
    rdfs:label "denominación anterior"@es ; rdfs:label "former name"@en ; rdfs:label "denominação anterior"@pt .

arleko:fechaInicioActividad a owl:DatatypeProperty ;
    rdfs:domain arleko:OrganoEmisor ; rdfs:range xsd:date ;
    rdfs:label "fecha de inicio de actividad"@es ; rdfs:label "activity start date"@en ; rdfs:label "data de início de atividade"@pt .

arleko:fechaCeseActividad a owl:DatatypeProperty ;
    rdfs:domain arleko:OrganoEmisor ; rdfs:range xsd:date ;
