  {
    "@id": "https://w3id.org/arleko",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-11-20"
      }
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@id": "https://github.com/ar-leko"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "es",
        "@value": "Ontología OWL 2 para representar normas jurídicas argentinas, su estructura, sus versiones temporales, sus modificaciones y su contexto institucional y territorial."
      },
      {
        "@language": "en",
        "@value": "OWL 2 ontology for Argentine legal norms, their structure, temporal versions, amendments, and institutional and territorial context."
      }
    ],
    "http://purl.org/dc/terms/license": [
      {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      }
    ],
    "http://purl.org/dc/terms/modified": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-11-20"
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@language": "es",
        "@value": "AR-LEKO - Ontología del Conocimiento Jurídico Argentino"
      },
      {
        "@language": "en",
        "@value": "AR-LEKO - Argentine Legal Knowledge Ontology"
      },
      {
        "@language": "pt",
        "@value": "AR-LEKO - Ontologia do Conhecimento Jurídico Argentino"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespacePrefix": [
      {
        "@value": "arleko"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespaceUri": [
      {
        "@value": "https://w3id.org/arleko#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "es",
        "@value": "AR-LEKO (Argentine Legal Knowledge Ontology) es una ontología OWL 2 para representar\nnormas jurídicas argentinas de cualquier nivel y de cualquier organismo emisor.\n\nCAMBIOS v1.3.0:\n- Etiquetas en portugués (@pt) para todas las clases, propiedades y conceptos.\n- Esquema restrictivo de unidades territoriales (arlekov:EsquemaUnidadTerritorial) que incluye\n  departamentos/partidos y ámbitos marítimos.\n- Separación entre estado de vigencia y estado de modificación para evitar tratar\n  \"vigente\" y \"modificada\" como estados mutuamente excluyentes.\n- Se mantienen las distinciones entre sancionadaPor, promulgadaPor y emitidaPor.\n- Se corrige la separación conceptual entre jurisdicción y unidad territorial.\n- Se aclara que Alta Mar es un espacio marítimo, no un espacio bajo soberanía argentina.\n\nIDIOMAS: castellano (@es) primario, inglés (@en) y portugués (@pt) para interoperabilidad.\n"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionIRI": [
      {
        "@id": "https://w3id.org/arleko/1.3.0"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "1.3.0"
      }
    ]
  },
