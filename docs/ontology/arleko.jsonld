    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "es",
        "@value": "La obra normativa ha sido alterada total o parcialmente por uno o más actos posteriores. Este estado no determina por sí solo si la norma está vigente, derogada o suspendida."
      }
    ],
