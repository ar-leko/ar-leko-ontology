  <owl:Class rdf:about="https://w3id.org/arleko#UnidadNormativa">
    <rdfs:subClassOf rdf:resource="https://w3id.org/arleko#ObraJuridica"/>
    <rdfs:subClassOf rdf:resource="http://data.europa.eu/eli/ontology#LegalResourceSubdivision"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n5ec8842340ca4df988e9098227dc62adb3">
        <owl:onProperty rdf:resource="https://w3id.org/arleko#esHijoDe"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/arleko#ObraJuridica"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n5ec8842340ca4df988e9098227dc62adb4">
        <owl:onProperty rdf:resource="https://w3id.org/arleko#perteneceANorma"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/arleko#Norma"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n5ec8842340ca4df988e9098227dc62adb5">
        <owl:onProperty rdf:resource="https://w3id.org/arleko#tipoNivel"/>
        <owl:someValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n5ec8842340ca4df988e9098227dc62adb6">
        <owl:onProperty rdf:resource="https://w3id.org/arleko#tieneVersion"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/arleko#Version"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="es">Unidad normativa</rdfs:label>
    <rdfs:label xml:lang="en">Normative unit</rdfs:label>
    <rdfs:label xml:lang="pt">Unidade normativa</rdfs:label>
    <rdfs:comment xml:lang="es">Cualquier subdivisión estructural de una Norma (libro, título, capítulo, artículo, inciso, anexo).</rdfs:comment>
  </owl:Class>
  <skos:Concept rdf:about="https://w3id.org/arleko/vocab#Nivel-Subinciso">
    <skos:inScheme rdf:resource="https://w3id.org/arleko/vocab#EsquemaNivelUnidad"/>
    <skos:prefLabel xml:lang="es">Subinciso</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Subitem</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Subinciso</skos:prefLabel>
    <arleko:puedeSerNivelRaiz rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</arleko:puedeSerNivelRaiz>
  </skos:Concept>
  <owl:Class rdf:about="https://w3id.org/arleko#OrganoEmisor">
    <rdfs:label xml:lang="es">Órgano emisor</rdfs:label>
    <rdfs:label xml:lang="en">Issuing body</rdfs:label>
    <rdfs:label xml:lang="pt">Órgão emissor</rdfs:label>
    <rdfs:comment xml:lang="es">Autoridad que dicta o emite una norma. Para actos legislativos (leyes), el Congreso/Legislatura sanciona; el Ejecutivo promulga. Para actos administrativos (resoluciones, comunicaciones), el organismo emite.</rdfs:comment>
  </owl:Class>
</rdf:RDF>
