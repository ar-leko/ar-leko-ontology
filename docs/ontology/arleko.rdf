  <owl:ObjectProperty rdf:about="https://w3id.org/arleko#estadoModificacionActual">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/arleko#Norma"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="es">estado de modificación actual</rdfs:label>
    <rdfs:label xml:lang="en">current amendment status</rdfs:label>
    <rdfs:label xml:lang="pt">estado de modificação atual</rdfs:label>
    <rdfs:comment xml:lang="es">Indica si la obra normativa ha sido modificada. El concepto debe pertenecer a arlekov:EsquemaEstadoModificacion. Es independiente del estado de vigencia.</rdfs:comment>
  </owl:ObjectProperty>
  <skos:Concept rdf:about="https://w3id.org/arleko/vocab#TipoNorma-Tratado">
    <skos:inScheme rdf:resource="https://w3id.org/arleko/vocab#EsquemaTipoNorma"/>
