    <skos:prefLabel xml:lang="pt">Zona contígua</skos:prefLabel>
    <skos:scopeNote xml:lang="es">Hasta 24 millas marinas desde las líneas de base.</skos:scopeNote>
  </skos:Concept>
  <skos:Concept rdf:about="https://w3id.org/arleko/vocab#UnidadTerritorial-CiudadAutonoma">
