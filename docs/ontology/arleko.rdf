    <skos:prefLabel xml:lang="pt">Comuna</skos:prefLabel>
    <skos:scopeNote xml:lang="es">División territorial dentro de la Ciudad Autónoma de Buenos Aires (Ley 1777, no aplicada plenamente).</skos:scopeNote>
  </skos:Concept>
