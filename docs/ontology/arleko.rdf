    <rdfs:label xml:lang="en">issued by</rdfs:label>
    <rdfs:label xml:lang="pt">emitida por</rdfs:label>
    <rdfs:comment xml:lang="es">Para actos administrativos (resoluciones, comunicaciones, disposiciones). Para leyes, usar sancionadaPor y promulgadaPor.</rdfs:comment>
  </owl:ObjectProperty>
