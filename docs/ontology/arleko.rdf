        <rdfs:label xml:lang="en">ratification date</rdfs:label>
        <rdfs:label xml:lang="pt">data de ratificação</rdfs:label>
      </owl:DatatypeProperty>
    </arleko:fechaAplicable>
    <arleko:fechaAplicable rdf:resource="https://w3id.org/arleko#fechaPublicacion"/>
    <arleko:fechaAplicable rdf:resource="https://w3id.org/arleko#fechaEntradaVigencia"/>
    <arleko:fechaAplicable rdf:resource="https://w3id.org/arleko#fechaCeseVigencia"/>
    <arleko:puedeModificarTipoNorma rdf:resource="https://w3id.org/arleko/vocab#TipoNorma-TratadoIntegracion"/>
  </skos:Concept>
