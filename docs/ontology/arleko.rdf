    <skos:prefLabel xml:lang="pt">Cidade Autônoma</skos:prefLabel>
    <skos:scopeNote xml:lang="es">Ciudad Autónoma de Buenos Aires. Mismo nivel de autonomía que una provincia (art. 129 CN).</skos:scopeNote>
  </skos:Concept>
  <owl:ObjectProperty rdf:about="https://w3id.org/arleko#promulgadaPor">
    <rdfs:domain rdf:resource="https://w3id.org/arleko#Norma"/>
    <rdfs:range rdf:resource="https://w3id.org/arleko#OrganoEmisor"/>
    <rdfs:label xml:lang="es">promulgada por</rdfs:label>
    <rdfs:label xml:lang="en">promulgated by</rdfs:label>
    <rdfs:label xml:lang="pt">promulgada por</rdfs:label>
    <rdfs:comment xml:lang="es">Poder Ejecutivo que promulga la ley (expresa o tácitamente), conforme arts. 78 y 80 CN.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/arleko#emitidaPor">
    <rdfs:domain rdf:resource="https://w3id.org/arleko#Norma"/>
    <rdfs:range rdf:resource="https://w3id.org/arleko#OrganoEmisor"/>
