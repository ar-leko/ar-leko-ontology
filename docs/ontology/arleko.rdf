  <owl:ObjectProperty rdf:about="https://w3id.org/arleko#estadoLegalActual">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="https://w3id.org/arleko#estadoVigenciaActual">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/arleko#tieneEstadoLegal"/>
        <rdfs:domain rdf:resource="https://w3id.org/arleko#Norma"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:label xml:lang="es">estado de vigencia actual</rdfs:label>
        <rdfs:label xml:lang="en">current validity status</rdfs:label>
        <rdfs:label xml:lang="pt">estado de vigência atual</rdfs:label>
        <rdfs:comment xml:lang="es">Estado de vigencia de la norma. El valor debe pertenecer a arlekov:EsquemaEstadoLegal.</rdfs:comment>
      </owl:ObjectProperty>
    </rdfs:subPropertyOf>
    <rdfs:domain rdf:resource="https://w3id.org/arleko#Norma"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="es">estado legal actual (compatibilidad)</rdfs:label>
    <rdfs:label xml:lang="en">current legal status (compatibility)</rdfs:label>
    <rdfs:label xml:lang="pt">estado legal atual (compatibilidade)</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:comment xml:lang="es">Propiedad heredada por compatibilidad. Para nuevos datos, utilizar estadoVigenciaActual y, cuando corresponda, estadoAplicacionActual y estadoModificacionActual.</rdfs:comment>
  </owl:ObjectProperty>
  <skos:Concept rdf:about="https://w3id.org/arleko/vocab#EstadoLegal-Anulada">
    <skos:inScheme>
      <skos:ConceptScheme rdf:about="https://w3id.org/arleko/vocab#EsquemaEstadoLegal">
        <skos:prefLabel xml:lang="es">Estado legal</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Legal status</skos:prefLabel>
        <skos:prefLabel xml:lang="pt">Estado legal</skos:prefLabel>
        <skos:definition xml:lang="es">Vocabulario controlado para el estado de vigencia de una norma. La suspensión de aplicación y la condición de modificada se representan en esquemas separados.</skos:definition>
      </skos:ConceptScheme>
    </skos:inScheme>
    <skos:prefLabel xml:lang="es">Anulada</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Annulled</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Anulada</skos:prefLabel>
    <skos:definition xml:lang="es">La norma ha sido declarada nula por autoridad competente. El alcance temporal y los efectos de la nulidad dependen de la decisión y del régimen jurídico aplicable.</skos:definition>
  </skos:Concept>
  <owl:ObjectProperty rdf:about="https://w3id.org/arleko#estadoAplicacionActual">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/arleko#Norma"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="es">estado de aplicación actual</rdfs:label>
    <rdfs:label xml:lang="en">current applicability status</rdfs:label>
    <rdfs:label xml:lang="pt">estado de aplicação atual</rdfs:label>
    <rdfs:comment xml:lang="es">Indica si la aplicación de la norma está operativa o suspendida. El valor debe pertenecer a arlekov:EsquemaEstadoAplicacion.</rdfs:comment>
  </owl:ObjectProperty>
  <skos:Concept rdf:about="https://w3id.org/arleko/vocab#Nivel-DisposicionTransitoria">
