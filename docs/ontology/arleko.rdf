  <skos:Concept rdf:about="https://w3id.org/arleko/vocab#EstadoAplicacion-Suspendida">
    <skos:inScheme>
      <skos:ConceptScheme rdf:about="https://w3id.org/arleko/vocab#EsquemaEstadoAplicacion">
        <skos:prefLabel xml:lang="es">Estado de aplicación</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Applicability status</skos:prefLabel>
        <skos:prefLabel xml:lang="pt">Estado de aplicação</skos:prefLabel>
        <skos:definition xml:lang="es">Vocabulario controlado para describir si la aplicación de una norma está operativa o suspendida, con independencia de su vigencia formal.</skos:definition>
      </skos:ConceptScheme>
    </skos:inScheme>
    <skos:prefLabel xml:lang="es">Suspendida</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Suspended</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Suspensa</skos:prefLabel>
    <skos:definition xml:lang="es">La aplicación de la norma está temporalmente suspendida, sin que ello implique por sí mismo su derogación o pérdida de vigencia formal.</skos:definition>
  </skos:Concept>
  <skos:Concept rdf:about="https://w3id.org/arleko/vocab#AmbitoMaritimo-ZonaContigua">
    <skos:inScheme rdf:resource="https://w3id.org/arleko/vocab#EsquemaAmbitoMaritimo"/>
