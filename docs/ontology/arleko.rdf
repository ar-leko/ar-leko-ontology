  <skos:Concept rdf:about="https://w3id.org/arleko/vocab#EstadoModificacion-Modificada">
    <skos:inScheme>
      <skos:ConceptScheme rdf:about="https://w3id.org/arleko/vocab#EsquemaEstadoModificacion">
        <skos:prefLabel xml:lang="es">Estado de modificación</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Amendment status</skos:prefLabel>
        <skos:prefLabel xml:lang="pt">Estado de modificação</skos:prefLabel>
        <skos:definition xml:lang="es">Indica si la obra normativa ha sufrido modificaciones, con independencia de que continúe vigente.</skos:definition>
      </skos:ConceptScheme>
    </skos:inScheme>
    <skos:prefLabel xml:lang="es">Modificada</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Amended</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Modificada</skos:prefLabel>
    <skos:definition xml:lang="es">La obra normativa ha sido alterada total o parcialmente por uno o más actos posteriores. Este estado no determina por sí solo si la norma está vigente, derogada o suspendida.</skos:definition>
  </skos:Concept>
