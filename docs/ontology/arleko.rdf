    <rdfs:label xml:lang="en">territorial scope</rdfs:label>
    <rdfs:label xml:lang="pt">âmbito territorial</rdfs:label>
    <rdfs:comment xml:lang="es">Ámbito espacial de aplicación de la norma. Los conceptos marítimos describen espacios geográficos y no implican por sí mismos soberanía o jurisdicción argentina. Valores controlados en arlekov:EsquemaAmbitoMaritimo.</rdfs:comment>
  </owl:ObjectProperty>
  <skos:Concept rdf:about="https://w3id.org/arleko/vocab#UnidadTerritorial-Comuna">
