  <skos:Concept rdf:about="https://w3id.org/arleko/vocab#AmbitoMaritimo-MarTerritorial">
    <skos:inScheme>
      <skos:ConceptScheme rdf:about="https://w3id.org/arleko/vocab#EsquemaAmbitoMaritimo">
        <skos:prefLabel xml:lang="es">Ámbitos marítimos</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Maritime scopes</skos:prefLabel>
        <skos:prefLabel xml:lang="pt">Âmbitos marítimos</skos:prefLabel>
        <skos:definition xml:lang="es">Categorías de espacios marítimos relevantes para describir el ámbito espacial de normas. Su inclusión no implica que Argentina ejerza soberanía o derechos soberanos sobre todos ellos.</skos:definition>
      </skos:ConceptScheme>
    </skos:inScheme>
    <skos:prefLabel xml:lang="es">Mar territorial</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Territorial sea</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Mar territorial</skos:prefLabel>
    <skos:scopeNote xml:lang="es">Hasta 12 millas marinas desde las líneas de base. Soberanía del Estado ribereño.</skos:scopeNote>
  </skos:Concept>
