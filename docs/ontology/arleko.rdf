        <skos:prefLabel xml:lang="pt">Níveis de unidade</skos:prefLabel>
      </skos:ConceptScheme>
    </skos:inScheme>
    <skos:prefLabel xml:lang="es">Disposición transitoria</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Transitory provision</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Disposição transitória</skos:prefLabel>
    <arleko:puedeSerNivelRaiz rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</arleko:puedeSerNivelRaiz>
    <arleko:puedeContenerNivel>
      <skos:Concept rdf:about="https://w3id.org/arleko/vocab#Nivel-Parrafo">
        <skos:inScheme rdf:resource="https://w3id.org/arleko/vocab#EsquemaNivelUnidad"/>
        <skos:prefLabel xml:lang="es">Párrafo</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Paragraph</skos:prefLabel>
        <skos:prefLabel xml:lang="pt">Parágrafo</skos:prefLabel>
        <arleko:puedeSerNivelRaiz rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</arleko:puedeSerNivelRaiz>
        <arleko:puedeContenerNivel rdf:resource="https://w3id.org/arleko/vocab#Nivel-Inciso"/>
      </skos:Concept>
    </arleko:puedeContenerNivel>
    <arleko:puedeContenerNivel>
      <skos:Concept rdf:about="https://w3id.org/arleko/vocab#Nivel-Inciso">
        <skos:inScheme rdf:resource="https://w3id.org/arleko/vocab#EsquemaNivelUnidad"/>
        <skos:prefLabel xml:lang="es">Inciso</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Item</skos:prefLabel>
        <skos:prefLabel xml:lang="pt">Inciso</skos:prefLabel>
        <arleko:puedeSerNivelRaiz rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</arleko:puedeSerNivelRaiz>
        <arleko:puedeContenerNivel rdf:resource="https://w3id.org/arleko/vocab#Nivel-Subinciso"/>
      </skos:Concept>
    </arleko:puedeContenerNivel>
  </skos:Concept>
